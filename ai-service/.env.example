# ai-service environment variables
# This file is gitignored — do NOT commit secrets

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# v4-pro: premium (1.6T MoE, 49B active, supports thinking mode)
# v4-flash: fast (284B MoE, 13B active, no thinking)
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_MAX_TOKENS=800

# Server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
# OpenAPI spec 中的 server URL：本地用 http://localhost:8000，生产用 /ai（nginx 代理）
AI_SERVICE_SERVER_URL=http://localhost:8000
