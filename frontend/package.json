{
  "name": "vue-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,scss}\""
  },
  "dependencies": {
    "axios": "^1.17.0",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.12",
    "vue-tsc": "^2.2.0"
  }
}
